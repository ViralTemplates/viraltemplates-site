{#- The site's only header. A three-column grid: brand | links | CTA + burger.
    The links sit in the auto middle column, so they are optically centred in
    the pill whatever the logo and CTA measure. Logo mark only, no wordmark. -#}
<header class="site-header">
    <nav class="nav" aria-label="Main">
      <a class="nav__brand" href="/">
        <span class="nav__mark">
          <picture>
            <source srcset="/assets/img/vt-logo.webp" type="image/webp">
            <img src="/assets/img/vt-logo.png" width="34" height="19"
                 alt="Viral Templates" fetchpriority="high" decoding="async">
          </picture>
        </span>
      </a>

      <ul class="nav__links" id="nav-links">
        <li>
          <a class="nav__link" href="/templates/"
             {% if page.url == "/templates/" %}aria-current="page"{% endif %}>Templates</a>
        </li>
        <li><a class="nav__link" href="/#reviews">Reviews</a></li>
        <li>
          <a class="nav__link" href="/contact/"
             {% if page.url == "/contact/" %}aria-current="page"{% endif %}>Contact</a>
        </li>
        <li>
          <a class="nav__link" href="/terms/"
             {% if page.url == "/terms/" %}aria-current="page"{% endif %}>Terms</a>
        </li>
        {#- Shown only inside the mobile dropdown; the desktop CTA is in .nav__end. -#}
        <li class="nav__menu-cta">
          <a class="btn btn--primary nav__cta" href="{{ site.discord }}"
             rel="noopener" target="_blank">Join the Discord</a>
        </li>
      </ul>

      <div class="nav__end">
        <a class="btn btn--primary nav__cta" href="{{ site.discord }}"
           rel="noopener" target="_blank">Join the Discord</a>
        <button class="nav__toggle" type="button" aria-expanded="false"
                aria-controls="nav-links">
          <span class="visually-hidden">Menu</span>
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      </div>
    </nav>
</header>
