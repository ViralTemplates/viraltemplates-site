{#- The site's only footer. Social marks are inline SVG — sharper than the PNGs
    the old build shipped, and no extra requests. -#}
<footer class="site-footer">
  <div class="well">
    <div class="footer__grid">
      <div class="footer__brand">
        <picture>
          <source srcset="/assets/img/vt-logo.webp" type="image/webp">
          <img src="/assets/img/vt-logo.png" width="44" height="24"
               alt="Viral Templates" loading="lazy" decoding="async">
        </picture>
        <p class="footer__blurb">{{ site.tagline }}</p>
        <div class="footer__social">
          <a href="{{ site.discord }}" data-brand="discord" rel="noopener" target="_blank">
            <span class="visually-hidden">Viral Templates on Discord</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.32 4.57A19.79 19.79 0 0 0 15.43 3c-.24.43-.5 1-.68 1.46a18.3 18.3 0 0 0-5.5 0C9.07 4 8.8 3.43 8.56 3a19.74 19.74 0 0 0-4.89 1.57C.56 9.24-.28 13.78.14 18.26A19.93 19.93 0 0 0 6.19 21c.49-.66.92-1.37 1.29-2.11-.71-.27-1.39-.6-2.03-.98.17-.13.34-.26.5-.4a14.23 14.23 0 0 0 12.1 0c.16.14.33.27.5.4-.64.38-1.32.71-2.03.98.37.74.8 1.45 1.29 2.11a19.9 19.9 0 0 0 6.05-2.74c.5-5.18-.85-9.68-3.54-13.69ZM8.02 15.52c-1.18 0-2.15-1.09-2.15-2.42 0-1.34.95-2.43 2.15-2.43s2.17 1.1 2.15 2.43c0 1.33-.95 2.42-2.15 2.42Zm7.96 0c-1.18 0-2.15-1.09-2.15-2.42 0-1.34.95-2.43 2.15-2.43s2.17 1.1 2.15 2.43c0 1.33-.95 2.42-2.15 2.42Z"/></svg>
          </a>
          <a href="{{ site.twitter }}" data-brand="x" rel="noopener" target="_blank">
            <span class="visually-hidden">Viral Templates on X</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.96 6.82H1.68l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.11l11.97 15.64Z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h2 class="footer__heading">Store</h2>
        <ul class="footer__list">
          <li><a href="/templates/">All game templates and asset packs</a></li>
          {%- for p in products %}
          <li><a href="/{{ p.slug }}/">{{ p.name }}</a></li>
          {%- endfor %}
        </ul>
      </div>

      <div>
        <h2 class="footer__heading">Help</h2>
        <ul class="footer__list">
          <li><a href="/contact/">Contact us</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__base">
      <p>&copy; {{ buildYear }} {{ site.siteName }}. Not affiliated with or endorsed by Roblox Corporation.</p>
    </div>
  </div>
</footer>
